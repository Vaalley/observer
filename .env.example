# Bot token. SECRET - never commit. Discord Developer Portal > your app > Bot > Reset Token.
# Shown only once; resetting it disconnects a running bot.
DISCORD_TOKEN=

# Application (client) ID. Not secret - it is public in the invite URL.
# Discord Developer Portal > your app > General Information > Application ID.
DISCORD_APP_ID=

# Guild the commands are registered in (the MCTraveler Discord server). Not secret.
# Enable Settings > Advanced > Developer Mode, then right-click the server icon > Copy Server ID.
DISCORD_GUILD_ID=

# Conduit HTTP interface (the Fabric mod) that Observer talks to.
# CONDUIT_URL is not secret; CONDUIT_TOKEN must match the server's CONDUIT_HTTP_TOKEN.
# If running Observer in Docker with network_mode: host, 127.0.0.1 works.
# If using a Docker bridge, use http://host.docker.internal:8080 instead.
CONDUIT_URL=http://127.0.0.1:8080
CONDUIT_TOKEN=

# The Discord channel ID that acts as a two-way bridge with in-game chat.
# Messages posted here are sent to the Minecraft server, and player chat from
# the server is mirrored back here. Right-click a channel in Developer Mode
# and select Copy Channel ID. Leave empty to disable the bridge.
DISCORD_CHAT_CHANNEL_ID=

# GitHub token used by /feedback to file issues on https://github.com/Vaalley/conduit. SECRET.
# Needs "public_repo" scope (classic token) or Issues: Read & write (fine-grained token) on that repo.
# Create one at https://github.com/settings/tokens. Leave empty to disable /feedback.
GITHUB_TOKEN=

# Firebase service account for storing survey responses. SECRET - never commit.
# Choose one of the following:
#   - FIREBASE_SERVICE_ACCOUNT_PATH: absolute path to the downloaded JSON file.
#     In Docker this should match the compose volume mount (e.g. /app/firebase-service-account.json).
#     Make sure the file is readable by the container user (chmod 644).
#   - FIREBASE_SERVICE_ACCOUNT_JSON: the full JSON string (minified/escaped).
#   - FIREBASE_SERVICE_ACCOUNT_BASE64: the JSON file base64-encoded (base64 -w 0 file.json).
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
